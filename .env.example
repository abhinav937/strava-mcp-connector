# =============================================================================
# Strava MCP Connector — environment template (NO SECRETS)
# Copy to server/.env or ~/.strava-mcp-connector.env and fill in YOUR values.
#
# Each installer creates THEIR OWN Strava API application:
#   https://www.strava.com/settings/api
# There is no shared publisher Client ID / Secret.
# Prefer OAuth (HTTP) over pasting access/refresh tokens.
#
# PREREQUISITE: Strava subscription (Premium/Subscriber) is required for
# Standard Tier API access (2026 policy). See:
# https://communityhub.strava.com/developers-knowledge-base-14/strava-api-faq-12906
#
# Default OAuth scopes: profile:read_all,activity:read_all,activity:read,profile:write
# Rate limits apply to YOUR app. Segment explore may need Extended Access.
# =============================================================================

# --- Required: your Strava API app (user-supplied) ---
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# =============================================================================
# HTTP mode (default — local or self-hosted OAuth)
# =============================================================================

# Public base URL of THIS MCP server (used to build Strava redirect URI)
# Local:  http://localhost:8000
# Prod:   https://your-hosted-domain.example
STRAVA_MCP_BASE_URL=http://localhost:8000

STRAVA_MCP_HOST=127.0.0.1
STRAVA_MCP_PORT=8000
STRAVA_MCP_PATH=/mcp
STRAVA_MCP_TRANSPORT=http

# On https://www.strava.com/settings/api set:
#   Authorization Callback Domain: localhost   (local)
#                                  or your hosted hostname
# Full redirect URI:
#   {STRAVA_MCP_BASE_URL}/oauth/strava/callback
# Example local: http://localhost:8000/oauth/strava/callback

# OAuth scopes (comma-separated)
# STRAVA_OAUTH_SCOPES=profile:read_all,activity:read_all,activity:read,profile:write

# Optional pre-registered MCP OAuth clients (semicolon-separated)
# Format: client_id=redirect_uri1,redirect_uri2;another_client=uri
# ChatGPT is registered by default; Cursor uses dynamic client registration.
# STRAVA_MCP_OAUTH_CLIENTS=

# Session storage: memory (local) or dynamodb (multi-instance / Lambda)
STRAVA_SESSION_BACKEND=memory
# STRAVA_SESSION_TABLE=strava-mcp-sessions
# AWS_REGION=us-east-1
# STRAVA_SESSION_TTL_SECONDS=864000

# =============================================================================
# stdio mode only (debug — tokens normally come from OAuth, not manual paste)
# Prefer: strava-mcp-connector auth   OR HTTP OAuth above
# =============================================================================
# STRAVA_ACCESS_TOKEN=
# STRAVA_REFRESH_TOKEN=

# =============================================================================
# Common
# =============================================================================
STRAVA_MEASUREMENT_PREFERENCE=meters
ROUTE_EXPORT_PATH=./exports
